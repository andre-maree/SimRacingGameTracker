@using GameTrackerWpfClientApp.Services.Sync
@using GameTrackerWpfClientApp.Services.Authentication
@inherits LayoutComponentBase
@implements IDisposable
@inject CatalogueSyncService CatalogueSync
@inject NotificationService Notifications
@inject AuthenticationState AuthState
@inject AuthenticationService Auth
@inject NavigationManager Navigation

@* Host for Radzen dialogs, notifications and tooltips. Without it those services fail
   silently at runtime with no compile-time error. *@
<RadzenComponents />

<RadzenLayout>
    <RadzenHeader>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem" class="rz-px-4">
            <RadzenText TextStyle="TextStyle.H6" class="rz-my-0">GameTracker</RadzenText>
            <RadzenLink Path="/" Text="Home" />
            <RadzenLink Path="/sessions" Text="Sessions" />
            <RadzenLink Path="/catalogue/cars" Text="Cars" />
            <RadzenLink Path="/catalogue/tracks" Text="Tracks" />

            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center"
                         Gap="0.5rem" class="rz-ml-auto">
                @* Always visible, even signed out. On a fresh install the catalogue mirror is
                   empty until the first sync, so hiding this would leave the empty Cars and
                   Tracks grids with no explanation and no way forward. *@
                <RadzenButton Icon="sync" Text="Sync catalogue" Size="ButtonSize.Small"
                              Variant="Variant.Flat" IsBusy="@_syncing" Disabled="@_syncing"
                              Click="@SyncAsync" />

                @if (AuthState.IsAuthenticated)
                {
                    @if (AuthState.IsAdmin)
                    {
                        <RadzenBadge Text="Admin" BadgeStyle="BadgeStyle.Info" />
                    }

                    <RadzenButton Icon="logout" Text="Sign out" Size="ButtonSize.Small"
                                  Variant="Variant.Text" ButtonStyle="ButtonStyle.Secondary"
                                  Click="@SignOutAsync" />
                }
                else
                {
                    @* Browsing works offline, so this states a fact rather than blocking. *@
                    <RadzenText TextStyle="TextStyle.Caption" class="rz-my-0">Offline</RadzenText>

                    <RadzenButton Icon="login" Text="Sign in" Size="ButtonSize.Small"
                                  Variant="Variant.Flat"
                                  Click="@(() => Navigation.NavigateTo("/login"))" />
                }
            </RadzenStack>
        </RadzenStack>
    </RadzenHeader>
    <RadzenBody>
        @Body
    </RadzenBody>
</RadzenLayout>

@code {
    private bool _syncing;

    protected override void OnInitialized()
    {
        // The handler raises SignedOut from a background thread on a 401, so the layout has
        // to re-render itself rather than waiting for a user interaction that may never come.
        AuthState.SignedIn += OnSignedIn;
        AuthState.SignedOut += OnAuthenticationChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // A token restored at startup raises SignedIn before this layout exists, so that
        // case is picked up here instead. Without it a returning user sees empty Cars and
        // Tracks grids until they press the sync button themselves.
        if (firstRender && AuthState.IsAuthenticated)
        {
            await SyncAsync();
        }
    }

    private void OnSignedIn()
    {
        // The catalogue mirror is only filled by a sync, and a sign-in is the first moment
        // one can succeed. Fired and forgotten on the renderer's context: the sign-in itself
        // must not wait on a network pull.
        _ = InvokeAsync(async () =>
        {
            StateHasChanged();
            await SyncAsync();
        });
    }

    private void OnAuthenticationChanged() => InvokeAsync(StateHasChanged);

    private async Task SignOutAsync()
    {
        await Auth.SignOutAsync();
        Navigation.NavigateTo("/login");
    }

    private async Task SyncAsync()
    {
        // Sync is the one action that genuinely needs a token. Rather than letting the request
        // fail with a 401 the user cannot act on, send them where they can fix it.
        if (!AuthState.IsAuthenticated)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        // A sync raised by the sign-in event can overlap with a click on the button; the
        // service turns the second caller away, but the busy state is this layout's own.
        if (_syncing)
        {
            return;
        }

        _syncing = true;
        StateHasChanged();

        try
        {
            var result = await CatalogueSync.SyncAsync();

            Notifications.Notify(new NotificationMessage
            {
                Severity = result.Succeeded ? NotificationSeverity.Success : NotificationSeverity.Warning,
                Summary = result.Succeeded ? "Catalogue synced" : "Sync incomplete",
                Detail = result.Succeeded
                    ? $"{result.RowsApplied} row(s) updated."
                    : result.Message ?? "The sync did not complete. See the log for details.",
                Duration = 4000
            });
        }
        finally
        {
            _syncing = false;
            StateHasChanged();
        }
    }

    public void Dispose()
    {
        // AuthenticationState is a singleton and outlives this layout, so an un-removed
        // handler would keep it alive and render into a dead context.
        AuthState.SignedIn -= OnSignedIn;
        AuthState.SignedOut -= OnAuthenticationChanged;
    }
}
