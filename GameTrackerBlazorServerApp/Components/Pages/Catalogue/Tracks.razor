@page "/catalogue/tracks"
@using GameTracker.Domain.Entities
@using GameTrackerBlazorServerApp.Data
@using GameTrackerRazorLibrary.Catalogue
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@rendermode InteractiveServer
@inject CatalogueService Catalogue
@inject NotificationService Notifications
@inject DialogService Dialogs

<PageTitle>Tracks</PageTitle>

<RadzenStack Gap="1rem" class="rz-p-4">
    <RadzenRow AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween">
        <RadzenText TextStyle="TextStyle.H4">Tracks</RadzenText>
        <AuthorizeView Roles="Admin">
            <RadzenButton Icon="add" Text="Add track" ButtonStyle="ButtonStyle.Primary" Click="@(() => EditAsync(new Track()))" />
        </AuthorizeView>
    </RadzenRow>

    <TrackCatalogueGrid @ref="_grid">
        <RowActions Context="track">
            <AuthorizeView Roles="Admin" Context="auth">
                <RadzenButton Icon="edit" Size="ButtonSize.Small" Variant="Variant.Text"
                              Click="@(() => EditAsync(track))" @onclick:stopPropagation="true" />
                <RadzenButton Icon="delete" Size="ButtonSize.Small" Variant="Variant.Text"
                              ButtonStyle="ButtonStyle.Danger"
                              Click="@(() => DeleteAsync(track))" @onclick:stopPropagation="true" />
            </AuthorizeView>
        </RowActions>
    </TrackCatalogueGrid>
</RadzenStack>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationState { get; set; }

    private TrackCatalogueGrid? _grid;

    private async Task EditAsync(Track track)
    {
        var saved = await Dialogs.OpenAsync<TrackEditor>(
            track.Id == 0 ? "Add track" : "Edit track",
            new Dictionary<string, object?> { { nameof(TrackEditor.Track), Clone(track) } });

        if (saved is true && _grid is not null)
        {
            await _grid.ReloadAsync();
        }
    }

    private async Task DeleteAsync(Track track)
    {
        var confirmed = await Dialogs.Confirm($"Delete '{track.Name} - {track.LayoutName}'?", "Confirm delete");
        if (confirmed != true)
        {
            return;
        }

        try
        {
            var user = await GetUserAsync();
            await Catalogue.DeleteTrackAsync(user, track.Id);

            if (_grid is not null)
            {
                await _grid.ReloadAsync();
            }
        }
        catch (UnauthorizedAccessException)
        {
            Notifications.Notify(NotificationSeverity.Error, "Not allowed", "Admin role required.");
        }
    }

    private async Task<System.Security.Claims.ClaimsPrincipal> GetUserAsync()
        => AuthenticationState is null
            ? new System.Security.Claims.ClaimsPrincipal()
            : (await AuthenticationState).User;

    private static Track Clone(Track track) => new()
    {
        Id = track.Id,
        GameId = track.GameId,
        ExternalId = track.ExternalId,
        Name = track.Name,
        LayoutName = track.LayoutName,
        Country = track.Country,
        LengthMetres = track.LengthMetres
    };
}
